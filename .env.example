# Names only: never commit real values. Copy to .env.local.

# Supabase (see README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which base map to draw by default: maplibre (default, no key) | google | stylised.
# Outside production you can also flip live with the switch on the map page or ?map=google.
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# MapLibre only: another OpenFreeMap style (bright, positron) or a MapTiler URL.
NEXT_PUBLIC_MAP_STYLE=

# Google Maps (only when the provider is google).
# Browser key: restrict by HTTP referrer and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Vector Map ID (Google Maps Platform > Map Management), needed for AdvancedMarker and dark mode.
NEXT_PUBLIC_GOOGLE_MAP_ID=
